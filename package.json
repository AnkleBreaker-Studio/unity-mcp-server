{
  "name": "anklebreaker-unity-mcp",
  "version": "2.36.0",
  "description": "Unity MCP Server — Multi-agent MCP server for Unity Editor, designed for Claude Cowork. By AnkleBreaker Studio.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnkleBreaker-Studio/unity-mcp-server.git"
  },
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "unity-mcp": "./src/index.js"
  },
  "files": [
    "src/",
    "manifest.json"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/protocol.test.mjs tests/hub.test.mjs tests/response-limits.test.mjs tests/http-response-limit.test.mjs tests/request-input-limit.test.mjs tests/unit/http-response-limit.test.mjs tests/cancellation.test.mjs tests/unit/request-cancellation.test.mjs tests/concurrency.test.mjs tests/discovery-identity.test.mjs tests/parrelsync-identity.test.mjs tests/discovery-concurrency.test.mjs tests/debug-logging.test.mjs tests/agent-state.test.mjs tests/queue-admission.test.mjs tests/result-retention.test.mjs tests/test-pagination.test.mjs tests/unit/agent-state.test.mjs tests/retry-safety.test.mjs tests/build-variants.test.mjs tests/play-mode-recovery.test.mjs tests/unit/tool-tiers.test.mjs tests/unit/capabilities.test.mjs tests/queue-poll-default.test.mjs tests/argument-translation.test.mjs",
    "test:stress": "node tests/multi-agent-stress-test.mjs --mock",
    "pack": "npx @anthropic-ai/mcpb pack . unity-mcp.mcpb && npx @anthropic-ai/mcpb clean unity-mcp.mcpb",
    "test:live": "node --test tests/live-smoke.test.mjs tests/live-probuilder-level.test.mjs",
    "test:builds": "node --test tests/live-build-variants.test.mjs",
    "test:lifecycle": "node --test tests/live-editor-lifecycle.test.mjs",
    "test:monitoring": "node --test tests/live-monitoring.test.mjs",
    "test:http-monitoring": "node --test tests/live-http-monitoring.test.mjs",
    "test:editor-capture": "node --test tests/live-editor-capture.test.mjs",
    "test:editor-render": "node --test tests/live-editor-render.test.mjs",
    "test:graphics": "node --test tests/live-graphics-capture.test.mjs",
    "test:previews": "node --test tests/live-asset-preview.test.mjs",
    "test:meshes": "node --test tests/live-mesh-metadata.test.mjs",
    "test:multiplayer": "node --test tests/live-multiplayer.test.mjs",
    "test:parrelsync": "node --test tests/live-parrelsync.test.mjs",
    "test:features": "node --test tests/live-features.test.mjs",
    "test:compatibility": "node --test tests/live-version-compatibility.test.mjs",
    "test:resources": "node --test tests/live-resource-routing.test.mjs",
    "test:responses": "node --test tests/live-response-limits.test.mjs",
    "test:cancellation": "node --test tests/live-cancellation.test.mjs",
    "test:discovery": "node --test tests/live-discovery-identity.test.mjs",
    "test:packages": "node --test tests/live-packages.test.mjs",
    "test:testing": "node --test tests/live-testing.test.mjs",
    "test:test-pagination": "node --test tests/live-test-pagination.test.mjs",
    "test:test-pagination-legacy": "node --test tests/live-test-pagination-legacy.test.mjs",
    "test:test-persistence": "node --test tests/live-test-persistence.test.mjs",
    "test:serialization": "node --test tests/live-serialization.test.mjs",
    "test:http-responses": "node --test tests/live-http-response-limit.test.mjs",
    "test:undo": "node --test tests/live-undo.test.mjs",
    "test:input": "node --test tests/live-request-input.test.mjs",
    "test:selection": "node --test tests/live-selection-concurrency.test.mjs",
    "test:agent-state": "node --test tests/live-agent-state.test.mjs",
    "test:queue-admission": "node --test tests/live-queue-admission.test.mjs",
    "test:result-retention": "node --test tests/live-result-retention.test.mjs",
    "test:session-retention": "node --test tests/live-session-retention.test.mjs",
    "test:history": "node --test tests/live-history-notifications.test.mjs",
    "test:history-window": "node --test tests/live-history-window.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
